# Kopiraj u .env.local i popuni. Bez Supabase ključeva sajt radi, ali
# poručivanje i admin panel nisu dostupni.

# Kanonski javni URL (bez / na kraju) — bitno za sitemap i Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role ključ — SAMO na serveru, nikad u browseru
SUPABASE_SERVICE_ROLE_KEY=

# EmailJS — obaveštenje o novoj porudžbini (opciono; bez ovoga se mejl ne šalje)
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_ORDER_TEMPLATE_ID=

# Google Analytics 4 — merni ID je već u lib/site-config.ts.
# Popuni samo ako treba drugi GA nalog. Radi samo u produkciji.
NEXT_PUBLIC_GA_ID=

# Google Search Console verifikacija (opciono)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

